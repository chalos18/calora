{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": {
      "@calora/core": ["../../packages/core/src/index.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  // Tests are checked here rather than by the root tsconfig.test.json: they
  // import app modules, which resolve under Expo's bundler resolution and not
  // under the NodeNext the rest of the repo uses.
  "exclude": ["node_modules"]
}
