// Test files are excluded from the build (they must not reach dist), so they
// are typechecked separately here rather than going unchecked.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@calora/core": ["./packages/core/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.test.ts",
    "server/src/**/*.test.ts",
    "data/seed/src/**/*.test.ts"
    // The mobile app's tests are checked by apps/mobile/tsconfig.json, which
    // has the bundler resolution they need.
  ]
}
